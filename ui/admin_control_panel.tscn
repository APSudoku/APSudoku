[connection signal="disabled_all_updated" from="." to="HBoxContainer2/ToggleHintGames" method="set_pressed"]
[connection signal="disabled_updated" from="." to="HBoxContainer2/ToggleSudoku" method="set_pressed"]
[connection signal="weights_updated" from="." to="Difficulties/Easy" method="update_weights"]
[connection signal="weights_updated" from="." to="Difficulties/Normal" method="update_weights"]
[connection signal="weights_updated" from="." to="Difficulties/Hard" method="update_weights"]
[connection signal="weights_updated" from="." to="Difficulties/Killer" method="update_weights"]
[connection signal="toggled" from="HBoxContainer2/ToggleHintGames" to="." method="set_hintgame_disabled"]
[connection signal="toggled" from="HBoxContainer2/ToggleSudoku" to="." method="set_sudoku_disabled"]
[connection signal="update_values" from="Difficulties/Easy" to="." method="set_values"]
[connection signal="update_values" from="Difficulties/Normal" to="." method="set_values"]
[connection signal="update_values" from="Difficulties/Hard" to="." method="set_values"]
[connection signal="update_values" from="Difficulties/Killer" to="." method="set_values"]
[connection signal="pressed" from="HBoxContainer/ApplyButton" to="." method="apply_settings"]
[connection signal="pressed" from="HBoxContainer/RevertButton" to="." method="revert_settings"]
