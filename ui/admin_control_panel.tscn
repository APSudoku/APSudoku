[node name="AdminControlPanel" type="VBoxContainer"]
theme_override_constants/separation = 2
script = ExtResource("1_v18te")
metadata/_custom_type_script = "uid://bvyjl05157b1k"

[node name="HBoxContainer2" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 4

[node name="ToggleHintGames" type="CheckButton" parent="HBoxContainer2"]
layout_mode = 2
size_flags_horizontal = 4
text = "Disable All* Hint Games"

[node name="InfoButton" parent="HBoxContainer2" instance=ExtResource("2_sy7sm")]
layout_mode = 2
title = "Disable All Hint Games"
info = "This setting can't actually force ALL hint games to be disabled- but the intent is that any hint game can choose to disable itself based on this setting."

[node name="ToggleSudoku" type="CheckButton" parent="HBoxContainer2"]
layout_mode = 2
size_flags_horizontal = 4
text = "Disable APSudoku"

[node name="InfoButton2" parent="HBoxContainer2" instance=ExtResource("2_sy7sm")]
layout_mode = 2
info = "If toggled on, this setting will prevent all APSudoku clients from generating hints."

[node name="Difficulties" type="GridContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 0
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
